<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 输出类型为桌面应用 -->
    <OutputType>WinExe</OutputType>
    <!--
      目标框架：
      - net8.0-windows：Windows 版，额外启用 WinForms 以承载 WebView2 内嵌浏览器，
        用于微软正版账号登录（和官方启动器一样，登录页在启动器窗口内完成）。
      - net8.0：通用版（Linux / macOS 或不需要内嵌浏览器的场景），
        微软登录会退化为“浏览器 + 粘贴回跳网址”的方式。
    -->
    <!-- Windows 下同时产出通用版与内嵌 WebView2 的 Windows 版；其他系统只构建通用版 -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0;net8.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFrameworks>
    <!-- 允许在更高版本的 .NET 运行时上运行（例如用户机器只装了 .NET 9/10） -->
    <RollForward>LatestMajor</RollForward>
    <!-- 启用可空引用类型，减少空引用异常 -->
    <Nullable>enable</Nullable>
    <!-- 开启隐式 using，简化代码 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Avalonia 需要在编译期生成 XAML 绑定代码 -->
    <BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DPL</RootNamespace>
    <AssemblyName>DPL</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>DPL</Authors>
    <Product>Diamond Pickaxe Launcher</Product>
    <AssemblyTitle>钻石镐启动器</AssemblyTitle>
    <!-- 启动器图标（任务栏 / 窗口图标） -->
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets/app.ico</ApplicationIcon>
    <!-- 启动器本身不依赖 Trim/AOT，保持默认以保证反射序列化可用 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Windows 专用：启用 WinForms，用于内嵌 WebView2 登录窗口 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <!-- app.manifest 里的高 DPI 设置是 Avalonia 需要的，WinForms 的 WFAC010 提示对此不适用 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- WebView2 包同时带 WPF 程序集，其 WindowsBase 版本与 .NET 8 不一致，这里把该提示降级为消息 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- 移除 WinForms 带来的隐式 using，避免与 Avalonia 的同名类型（Application / Label / UserControl 等）冲突 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 桌面 UI 框架 -->
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11" Condition="'$(Configuration)' == 'Debug'" />
    <!-- CmlLib.Core：Minecraft 版本列表、下载安装、启动进程构建的核心库 -->
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <!-- WebView2：微软登录页面内嵌浏览器（仅 Windows 版需要） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标等静态资源 -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

</Project>
