<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DPL.ViewModels"
             xmlns:models="using:DPL.Models"
             x:Class="DPL.Views.ModLoaderInstallView"
             x:DataType="vm:MainWindowViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,14,24,14">

    <!-- ==================== 页面标题 ==================== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="6">
        <Button Theme="{StaticResource GhostButtonTheme}" Content="← 返回下载列表"
                Command="{Binding BackToDownloadListCommand}"
                HorizontalAlignment="Left" Padding="12,6" FontSize="11" />
        <TextBlock Text="{Binding InstallPageTitle}" Classes="pageTitle" Margin="0,4,0,0" />
        <TextBlock Text="{Binding InstallPageSubtitle}" Classes="muted" FontSize="12" />
      </StackPanel>

      <Button Grid.Column="1" Theme="{StaticResource GhostButtonTheme}" Content="重新查询版本"
              Command="{Binding RefreshLoaderOptionsCommand}"
              VerticalAlignment="Bottom" />
    </Grid>

    <!-- ==================== 主体 ==================== -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Margin="0,0,4,0">

        <!-- 加载器选择 -->
        <TextBlock Text="选择要一起安装的模组加载器" Classes="sectionTitle" />

        <ItemsControl ItemsSource="{Binding LoaderOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LoaderOptionViewModel">
              <Button Theme="{StaticResource OptionCardButtonTheme}"
                      Classes.selected="{Binding IsSelected}"
                      Command="{Binding SelectCommand}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <!-- 左侧选择指示条 -->
                  <Border Width="4" Height="34" CornerRadius="2" VerticalAlignment="Center"
                          Background="{DynamicResource AccentBrush}"
                          IsVisible="{Binding IsSelected}" />

                  <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                              Padding="6,1" VerticalAlignment="Center"
                              IsVisible="{Binding HasBadge}">
                        <TextBlock Text="{Binding Badge}" FontSize="9.5"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="11" Classes="secondary"
                               TextWrapping="Wrap" />
                  </StackPanel>

                  <Border Grid.Column="2" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                          Background="{DynamicResource AccentSoftBrush}"
                          IsVisible="{Binding IsSelected}">
                    <TextBlock Text="已选择" FontSize="10"
                               Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 加载器版本选择 -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18"
                IsVisible="{Binding IsLoaderVersionVisible}">
          <StackPanel Spacing="10">
            <TextBlock Text="加载器版本" Classes="sectionTitle" />
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding LoaderVersions}"
                        SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                        PlaceholderText="正在查询可用版本…"
                        IsEnabled="{Binding !IsLoaderLoading}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ModLoaderVersionInfo">
                    <TextBlock Text="{Binding DisplayText}" FontSize="12" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock Text="{Binding LoaderStatusText}" FontSize="10.5" Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Fabric API 卡片 -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18"
                IsVisible="{Binding IsFabricApiCardVisible}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Fabric API" Classes="sectionTitle" />
                  <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                          Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="推荐" FontSize="9.5"
                               Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="绝大多数 Fabric 模组都依赖它；勾选后会随加载器一起下载到该版本的 mods 文件夹。"
                           FontSize="11" Classes="secondary" TextWrapping="Wrap" />
              </StackPanel>

              <CheckBox Grid.Column="1" Content="一起安装"
                        IsChecked="{Binding IncludeFabricApi, Mode=TwoWay}"
                        IsEnabled="{Binding CanIncludeFabricApi}"
                        VerticalAlignment="Top" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="推荐版本：" FontSize="11" Classes="fieldLabel"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding FabricApiVersionText}" FontSize="11.5"
                         Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{Binding FabricApiStatusText}" FontSize="10.5" Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 原版提示 -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18"
                IsVisible="{Binding IsVanillaLoaderSelected}">
          <StackPanel Spacing="6">
            <TextBlock Text="原版安装" Classes="sectionTitle" />
            <TextBlock Text="只安装 Mojang 官方原版文件，不包含任何模组加载器与模组。"
                       FontSize="11" Classes="secondary" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Forge / NeoForge 提示 -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18"
                IsVisible="{Binding IsForgeLikeLoaderSelected}">
          <StackPanel Spacing="6">
            <TextBlock Text="关于 Forge / NeoForge 安装" Classes="sectionTitle" />
            <TextBlock Text="这两个加载器需要运行官方安装器（依赖本机 Java），下载与安装通常需要几分钟，进度会显示在底部状态栏。"
                       FontSize="11" Classes="secondary" TextWrapping="Wrap" />
            <TextBlock Text="提示：Forge 安装成功后，其安装器会自行用浏览器打开一个 Forge 官方推广页（这是 CmlLib 安装库的固定行为，与启动器无关），关闭即可。"
                       FontSize="10.5" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ==================== 底部操作栏 ==================== -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
      <TextBlock Text="{Binding InstallSummaryText}" FontSize="11.5" Classes="secondary"
                 VerticalAlignment="Center" TextWrapping="Wrap" />

      <Button Grid.Column="1" Theme="{StaticResource GhostButtonTheme}" Content="取消任务"
              Command="{Binding CancelInstallCommand}"
              IsVisible="{Binding IsInstalling}"
              Margin="0,0,10,0" VerticalAlignment="Center" />

      <Button Grid.Column="2" Theme="{StaticResource PrimaryButtonTheme}"
              Content="{Binding InstallActionText}"
              Command="{Binding StartInstallCommand}"
              IsEnabled="{Binding CanStartInstall}"
              Padding="30,11" FontSize="13" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
