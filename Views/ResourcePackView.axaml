<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DPL.ViewModels"
             x:Class="DPL.Views.ResourcePackView"
             x:DataType="vm:ResourcePackBrowserViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,14,24,14"
        IsVisible="{Binding IsActive}">

    <!-- ==================== 标题 ==================== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="5">
        <TextBlock Text="资源包下载" Classes="pageTitle" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding TargetText}" Classes="secondary" FontSize="11.5" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
        <TextBlock Text="Modrinth（只按游戏版本过滤，与加载器无关）" Classes="muted" FontSize="10.5" />
      </StackPanel>
    </Grid>

    <!-- ==================== 搜索栏 ==================== -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="搜索资源包（材质包），例如 Fresh Animations"
               FontSize="12.5" VerticalAlignment="Center" />
      <Button Grid.Column="1" Theme="{StaticResource PrimaryButtonTheme}" Content="搜索"
              Command="{Binding SearchCommand}" IsEnabled="{Binding IsIdle}"
              Padding="24,8" Margin="10,0,0,0" />
    </Grid>

    <!-- ==================== 结果 + 版本 ==================== -->
    <Grid Grid.Row="2" ColumnDefinitions="*,320" ColumnSpacing="12">

      <!-- 结果列表 -->
      <Border Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="6">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Row="0" Text="{Binding ResultsTitle}" Classes="sectionTitle" Margin="10,8,10,6" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                   SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                   ItemContainerTheme="{StaticResource VersionListBoxItemTheme}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ResourcePackItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="10,7">
                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,1"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceText}" FontSize="9.5"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="10.5" Classes="secondary"
                               TextWrapping="Wrap" MaxLines="2" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding UpdatedAtText}" FontSize="10" Classes="muted"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding DownloadsText}" FontSize="10" Classes="muted"
                               HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 热门：轻提示 / 加载失败重试 / 空状态 / 加载中 -->
          <StackPanel Grid.Row="2" Margin="10,4,10,0" Spacing="6">
            <TextBlock Text="{Binding PopularNotice}" FontSize="10.5" Classes="muted"
                       TextWrapping="Wrap" IsVisible="{Binding HasPopularNotice}" />
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasPopularError}">
              <TextBlock Text="{Binding PopularError}" Classes="error" FontSize="10.5"
                         TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460" />
              <Button Theme="{StaticResource GhostButtonTheme}" Content="重试"
                      Command="{Binding RetryPopularCommand}" Padding="12,4" FontSize="10.5" />
            </StackPanel>
            <TextBlock Text="{Binding PopularEmptyText}" FontSize="11" Classes="muted"
                       IsVisible="{Binding ShowPopularEmpty}" />
            <TextBlock Text="正在加载热门资源包…" FontSize="10.5" Classes="muted"
                       IsVisible="{Binding IsLoadingPopular}" />
          </StackPanel>

          <!-- 热门：加载更多（offset 分页） -->
          <Button Grid.Row="3" Theme="{StaticResource GhostButtonTheme}" Content="加载更多"
                  Command="{Binding LoadMorePopularCommand}"
                  IsVisible="{Binding CanLoadMorePopular}"
                  HorizontalAlignment="Center" Padding="18,6" FontSize="11" Margin="0,8,0,2" />
        </Grid>
      </Border>

      <!-- 版本列表 -->
      <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Row="0" Text="兼容版本" Classes="sectionTitle" Margin="0,0,0,8" />

          <ListBox Grid.Row="1" ItemsSource="{Binding Versions}"
                   SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                   ItemContainerTheme="{StaticResource VersionListBoxItemTheme}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ResourcePackVersionViewModel">
                <StackPanel Spacing="2" Margin="8,6">
                  <TextBlock Text="{Binding DisplayText}" FontSize="11.5" />
                  <TextBlock Text="{Binding FileSizeText}" FontSize="9.5" Classes="muted" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Classes="error" FontSize="11"
                     TextWrapping="Wrap" Margin="0,8,0,0"
                     IsVisible="{Binding HasError}" />

          <Button Grid.Row="3" Theme="{StaticResource PrimaryButtonTheme}" Content="下载到 resourcepacks"
                  Command="{Binding DownloadCommand}" IsEnabled="{Binding IsIdle}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Padding="0,10" FontSize="12" Margin="0,10,0,0" />
        </Grid>
      </Border>
    </Grid>

    <!-- ==================== 状态 / 进度 ==================== -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding StatusText}" Classes="statusText" FontSize="11.5"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="180" Height="6" Minimum="0" Maximum="100"
                   Value="{Binding ProgressPercent}" IsVisible="{Binding IsDownloading}"
                   VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
