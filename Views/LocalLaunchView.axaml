<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DPL.ViewModels"
             xmlns:models="using:DPL.Models"
             x:Class="DPL.Views.LocalLaunchView"
             x:DataType="vm:MainWindowViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,14,24,14">

    <!-- ==================== 页面标题 ==================== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="5">
        <TextBlock Text="本地游戏库" Classes="pageTitle" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding LocalCountText}" Classes="secondary" FontSize="12" />
          <TextBlock Text="·" Classes="muted" FontSize="12" />
          <TextBlock Text="选择版本后即可启动游戏" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Theme="{StaticResource GhostButtonTheme}" Content="刷新列表"
                Command="{Binding RefreshLocalVersionsCommand}" />
        <Button Theme="{StaticResource PrimaryButtonTheme}" Content="下载版本"
                Command="{Binding ShowDownloadPageCommand}" />
      </StackPanel>
    </Grid>

    <!-- ==================== 页面主体 ==================== -->
    <Grid Grid.Row="1" ColumnDefinitions="*,332">

      <!-- 版本列表 -->
      <Grid Grid.Column="0" Margin="0,0,18,0">
        <ListBox ItemsSource="{Binding LocalVersions}"
                 SelectedItem="{Binding SelectedLocalVersion}"
                 ItemContainerTheme="{StaticResource VersionListBoxItemTheme}"
                 IsVisible="{Binding HasLocalVersions}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:VersionItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,12">
                <Border Grid.Column="0" Classes="versionBadge"
                        Classes.release="{Binding IsRelease}"
                        Classes.snapshot="{Binding IsSnapshot}"
                        Classes.old="{Binding IsOld}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding TypeText}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ReleaseTimeText}" FontSize="10.5" Classes="muted" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusText}" FontSize="10.5" Classes="accent"
                             VerticalAlignment="Center" IsVisible="{Binding HasStatusText}" />
                  <Button Theme="{StaticResource IconButtonTheme}"
                          Command="{Binding OpenFolderCommand}"
                          IsVisible="{Binding OpenFolderVisible}"
                          ToolTip.Tip="打开此版本的文件夹">
                    <Path Data="M2,4.5 H6.2 L7.6,6.3 H14 V13 H2 Z"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Width="13" Height="13" Stretch="Uniform" />
                  </Button>
                  <Button Theme="{StaticResource PrimaryButtonTheme}" Content="启动"
                          Command="{Binding LaunchCommand}"
                          IsVisible="{Binding LaunchButtonVisible}"
                          IsEnabled="{Binding IsIdle}"
                          Padding="16,6" FontSize="11.5" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <StackPanel IsVisible="{Binding IsLocalListEmpty}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
          <Border Width="56" Height="56" CornerRadius="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Path Data="M5,3 L15,9 L5,15 Z" Fill="{DynamicResource TextMutedBrush}"
                  Width="18" Height="18" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="还没有安装任何游戏版本" FontSize="15" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
          <TextBlock Text="前往“下载游戏”安装 Minecraft，安装完成后会自己出现在这里"
                     Classes="muted" FontSize="11.5" HorizontalAlignment="Center"
                     MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap" />
          <Button Theme="{StaticResource PrimaryButtonTheme}" Content="去下载Minecraft"
                  Command="{Binding ShowDownloadPageCommand}"
                  HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>

      <!-- 右侧启动设置面板 -->
      <Border Grid.Column="1"
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

          <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="已选版本" Classes="fieldLabel" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding SelectedVersionText}" FontSize="19" FontWeight="Bold"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Theme="{StaticResource GhostButtonTheme}"
                      Command="{Binding OpenSelectedVersionFolderCommand}"
                      IsEnabled="{Binding HasSelectedVersion}"
                      Content="版本文件夹" Padding="10,4" FontSize="10.5"
                      VerticalAlignment="Center" ToolTip.Tip="在文件管理器中打开该版本的文件夹" />
            </Grid>

            <!-- 账号快速切换：离线名称与已登录的微软正版账号都在这里 -->
            <TextBlock Text="账号" Classes="fieldLabel" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding Accounts}"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                        PlaceholderText="选择账号">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:AccountProfile">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                              Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindText}" FontSize="9"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Theme="{StaticResource GhostButtonTheme}" Content="账号设置"
                      Command="{Binding ShowSettingsPageCommand}"
                      Margin="8,0,0,0" Padding="10,6" FontSize="10.5"
                      ToolTip.Tip="打开设置页面管理离线账号与微软正版账号" />
            </Grid>
            <TextBlock Text="{Binding CurrentAccountDetail}" FontSize="10" Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>

          <!-- 启动参数 -->
          <StackPanel Grid.Row="1" Spacing="14" Margin="0,16,0,0">

            <StackPanel Spacing="6">
              <TextBlock Text="Java 运行时" Classes="fieldLabel" />
              <ComboBox ItemsSource="{Binding JavaCandidates}"
                        SelectedItem="{Binding SelectedJava}"
                        PlaceholderText="自动检测">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:JavaCandidate">
                    <TextBlock Text="{Binding DisplayName}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Theme="{StaticResource GhostButtonTheme}" Content="重新检测"
                        Command="{Binding AutoDetectJavaCommand}" Padding="10,4" FontSize="11" />
                <Button Theme="{StaticResource GhostButtonTheme}" Content="浏览…"
                        Command="{Binding BrowseJavaCommand}" Padding="10,4" FontSize="11" />
              </StackPanel>
              <TextBlock Text="{Binding JavaDetectedText}" FontSize="10" Classes="muted"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="最大内存" Classes="fieldLabel" />
                <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}" />
              </Grid>
              <Slider Minimum="1024" Maximum="16384" TickFrequency="512"
                      IsSnapToTickEnabled="True" Value="{Binding MaxMemoryMbSlider}" />
            </StackPanel>

            <CheckBox Content="启动前校验并补全游戏文件" IsChecked="{Binding CheckFilesBeforeLaunch}" />
          </StackPanel>

          <!-- 游戏日志 -->
          <Border Grid.Row="2" Background="{DynamicResource CodeBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="10" Margin="0,14,0,0" MinHeight="92">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,7,8,4">
                <TextBlock Text="游戏日志" FontSize="10.5" Classes="muted" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource GhostButtonTheme}" Content="清空"
                        Command="{Binding ClearLogCommand}" Padding="8,2" FontSize="10" />
              </Grid>
              <ScrollViewer Grid.Row="1" Margin="10,0,10,8"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding GameLogs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Classes="logLine" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- 启动器日志（网络 / 下载 / 模组搜索等，和游戏输出分开） -->
          <Border Grid.Row="3" Background="{DynamicResource CodeBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="10" Margin="0,10,0,0" MinHeight="80">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,7,8,4">
                <TextBlock Text="启动器日志" FontSize="10.5" Classes="muted" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource GhostButtonTheme}" Content="清空"
                        Command="{Binding ClearAppLogCommand}" Padding="8,2" FontSize="10" />
              </Grid>
              <ScrollViewer Grid.Row="1" Margin="10,0,10,8"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AppLogs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Classes="logLine" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- 启动按钮 -->
          <Button Grid.Row="4" Theme="{StaticResource PrimaryButtonTheme}"
                  Content="启动游戏"
                  Command="{Binding LaunchSelectedCommand}"
                  IsEnabled="{Binding HasSelectedVersion}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="0,12" FontSize="13.5" Margin="0,14,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
